{
  "name": "axion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply axion --local",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "predeploy": "npm run build && wrangler d1 migrations apply axion --remote",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
